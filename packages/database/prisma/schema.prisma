generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── KULLANICI ───────────────────────────────────────────────
enum Role {
  MAHKUM    // Tutuklu / Hükümlü
  AILE      // Aile Üyesi
  TAHLIYE   // Tahliye Olmuş
  AVUKAT    // Gönüllü Avukat
  GONULLU   // Gönüllü
  ADMIN     // Yönetici
}

enum UserStatus {
  ACTIVE
  PENDING    // Onay bekliyor (avukatlar)
  SUSPENDED  // Askıya alındı
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String
  username      String     @unique
  password      String?
  role          Role       @default(AILE)
  status        UserStatus @default(ACTIVE)
  bio           String?
  city          String?
  avatar        String?
  coverImage    String?
  website       String?
  verified      Boolean    @default(false)   // Avukat doğrulaması
  baroNo        String?                       // Sadece avukatlar
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // İlişkiler
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  bookmarks        Bookmark[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  followers        Follow[]        @relation("Followed")
  following        Follow[]        @relation("Following")
  questions        LegalQuestion[]
  answers          LegalAnswer[]
  legalComments    LegalComment[]
  reports          Report[]        @relation("Reporter")
  reportedPosts    Report[]        @relation("ReportedUser")
  notifications    Notification[]
  dsSchedule       DsSchedule?
  forumTopics      ForumTopic[]
  forumReplies     ForumReply[]
  news             News[]
  userBadges       UserBadge[]
  cart             Cart?
  orders           Order[]
  reviews          Review[]
  favorites        Favorite[]

  @@index([email])
  @@index([username])
}

// ─── TAKİP ───────────────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Followed",  fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ─── GÖNDERİ ─────────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  authorId    String
  content     String
  category    String   @default("Genel")
  isAnonymous Boolean  @default(false)
  isPinned    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reports   Report[]

  @@index([authorId])
  @@index([createdAt])
}

// ─── YORUM ───────────────────────────────────────────────────
model Comment {
  id          String   @id @default(cuid())
  postId      String
  authorId    String
  content     String
  isAnonymous Boolean  @default(false)
  parentId    String?
  createdAt   DateTime @default(now())

  post    Post      @relation(fields: [postId],   references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies Comment[] @relation("Replies")
  likes   Like[]

  @@index([postId])
}

// ─── BEĞENİ ──────────────────────────────────────────────────
model Like {
  id           String   @id @default(cuid())
  userId       String
  postId       String?
  commentId    String?
  forumReplyId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId],       references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId],       references: [id], onDelete: Cascade)
  comment    Comment?    @relation(fields: [commentId],    references: [id], onDelete: Cascade)
  forumReply ForumReply? @relation(fields: [forumReplyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@unique([userId, forumReplyId])
}

// ─── KAYDEDİLENLER ───────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// ─── FORUM ───────────────────────────────────────────────────
model ForumTopic {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  content     String
  category    String   @default("Genel")
  isAnonymous Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isSolved    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([category])
  @@index([createdAt])
}

model ForumReply {
  id          String   @id @default(cuid())
  topicId     String
  authorId    String
  content     String
  isAnonymous Boolean  @default(false)
  isSolution  Boolean  @default(false)
  createdAt   DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId],  references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  Like[]

  @@index([topicId])
}

// ─── HUKUKİ YARDIM ───────────────────────────────────────────
model LegalQuestion {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  content     String
  category    String   @default("Diğer")
  isAnonymous Boolean  @default(false)
  isAnswered  Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers  LegalAnswer[]
  comments LegalComment[]

  @@index([category])
  @@index([isAnswered])
}

model LegalAnswer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  isOfficial Boolean  @default(false)
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())

  question LegalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId],   references: [id], onDelete: Cascade)

  @@index([questionId])
}

model LegalComment {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  question LegalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId],   references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ─── MESAJLAŞMA ──────────────────────────────────────────────
model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([createdAt])
}

// ─── ŞİKAYET ─────────────────────────────────────────────────
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter     User  @relation("Reporter",     fields: [reporterId],     references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])
  post         Post? @relation(fields: [postId], references: [id])

  @@index([status])
}

// ─── BİLDİRİM ────────────────────────────────────────────────
enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  LEGAL_ANSWER
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── DS HATIRLATMA ───────────────────────────────────────────
model DsSchedule {
  id            String   @id @default(cuid())
  userId        String   @unique
  imzaGunleri   String?  // JSON: ["Salı","Cuma"] — imza atılacak günler
  imzaSaati     String?  // "09:30"
  seminerler    String?  // JSON: ["2026-04-15","2026-05-20"] — seminer tarihleri
  hatirlatmaGun Int      @default(1) // kaç gün önce hatırlat
  telefon       String?
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── HABER ───────────────────────────────────────────────────
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  imageUrl  String?
  category  String   @default("Haber")
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([published])
  @@index([createdAt])
}

// ─── ŞİFRE SIFIRLAMA ─────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

// ─── ROZET ───────────────────────────────────────────────────
enum BadgeType {
  ILK_GONDERI        // İlk gönderiyi yaptı
  ILK_YORUM          // İlk yorumu yaptı
  AKTIF_UYE          // 30+ gün üye
  FORUMC             // 5+ forum konusu açtı
  HUKUK_DESTEKCI     // Hukuki soruya yanıt verdi (avukat)
  TOPLULUK_KAHRAMANI // 50+ beğeni aldı
  DAYANISMA          // 20+ yorum yaptı
  DS_KULLANICI       // DS hatırlatma kurdu
  SORUCU             // Hukuki soru sordu
  KAHRAMAN_100       // 100+ gönderi/yorum
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  type      BadgeType
  awardedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ─── DUYURU ──────────────────────────────────────────────────
model Announcement {
  id        String    @id @default(cuid())
  text      String
  link      String?
  linkText  String?
  color     String    @default("bg-gold-500 text-navy-800")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([active])
}

// ─── DESTEK AĞI ──────────────────────────────────────────────
model SupportResource {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  city        String?
  phone       String?
  email       String?
  website     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([city])
  @@index([category])
}

// ─── E-TİCARET: KATEGORİLER ───────────────────────────────────
model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  description String?
  imageUrl  String?
  createdAt DateTime  @default(now())

  products Product[]

  @@index([slug])
}

// ─── E-TİCARET: ÜRÜNLER ───────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  categoryId  String
  price       Float
  quantity    Int      @default(0)    // Stok
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  cartItems   CartItem[]
  campaigns   CampaignProduct[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([categoryId])
  @@index([slug])
}

// ─── E-TİCARET: SEPET ─────────────────────────────────────────
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId],    references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// ─── E-TİCARET: SİPARİŞLER ────────────────────────────────────
enum OrderStatus {
  PENDING     // Ödeme bekleniyor
  CONFIRMED   // Ödeme onaylandı
  SHIPPED     // Gönderildi
  DELIVERED   // Teslim edildi
  CANCELLED   // İptal edildi
}

enum PaymentMethod {
  CREDIT_CARD // Kredi kartı
  TRANSFER    // Banka transferi/Havale
}

enum PaymentStatus {
  PENDING     // Ödeme bekleniyor
  COMPLETED   // Ödeme tamamlandı
  FAILED      // Ödeme başarısız
  CANCELLED   // İptal edildi
}

model Order {
  id              String        @id @default(cuid())
  userId          String?       // Guest checkout için optional
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  totalAmount     Float
  paymentMethod   PaymentMethod
  paymentId       String?
  shippingAddress String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float    // Ürünün satın alındığı fiyat
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── E-TİCARET: ÖDEMELER ──────────────────────────────────────
model Payment {
  id              String         @id @default(cuid())
  orderId         String?
  amount          Float
  currency        String         @default("TRY")
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  transactionId   String?        // Iyzico veya banka transaction ID
  description     String?
  metadata        String?        // JSON: Iyzico yanıtı vb.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order   Order[]

  @@index([status])
  @@index([transactionId])
}

// ─── E-TİCARET: KAMPANYALAR ───────────────────────────────────
model Campaign {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CampaignProduct[]

  @@index([active])
  @@index([startDate])
}

model CampaignProduct {
  id         String  @id @default(cuid())
  campaignId String
  productId  String
  discount   Float   // Yüzde (ör: 20 için %20 indirim)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
}

// ─── E-TİCARET: ÜRÜN YORUMLARI ────────────────────────────────
model Review {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  rating        Int      // 1-5
  title         String?  // Yorum başlığı
  text          String   // Yorum metni
  approved      Boolean  @default(false)  // Admin onayı
  helpfulCount  Int      @default(0)     // Kaç kişi faydalı buldu
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([approved])
}

// ─── E-TİCARET: FAVORİLER ─────────────────────────────────────
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}
