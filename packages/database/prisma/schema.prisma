generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── KULLANICI ───────────────────────────────────────────────
enum Role {
  MAHKUM    // Tutuklu / Hükümlü
  AILE      // Aile Üyesi
  TAHLIYE   // Tahliye Olmuş
  AVUKAT    // Gönüllü Avukat
  GONULLU   // Gönüllü
  ADMIN     // Yönetici
}

enum UserStatus {
  ACTIVE
  PENDING    // Onay bekliyor (avukatlar)
  SUSPENDED  // Askıya alındı
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String
  username      String     @unique
  password      String?
  role          Role       @default(AILE)
  status        UserStatus @default(ACTIVE)
  bio           String?
  city          String?
  avatar        String?
  coverImage    String?
  website       String?
  verified      Boolean    @default(false)   // Avukat doğrulaması
  baroNo        String?                       // Sadece avukatlar
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // İlişkiler
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  bookmarks        Bookmark[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  followers        Follow[]        @relation("Followed")
  following        Follow[]        @relation("Following")
  questions        LegalQuestion[]
  answers          LegalAnswer[]
  legalComments    LegalComment[]
  reports          Report[]        @relation("Reporter")
  reportedPosts    Report[]        @relation("ReportedUser")
  notifications    Notification[]
  dsSchedule       DsSchedule?
  forumTopics      ForumTopic[]
  forumReplies     ForumReply[]
  news             News[]
  userBadges       UserBadge[]
  cart             Cart?
  orders           Order[]
  reviews          Review[]
  favorites        Favorite[]
  preOrders        PreOrder[]

  @@index([email])
  @@index([username])
}

// ─── TAKİP ───────────────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Followed",  fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ─── GÖNDERİ ─────────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  authorId    String
  content     String
  category    String   @default("Genel")
  isAnonymous Boolean  @default(false)
  isPinned    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reports   Report[]

  @@index([authorId])
  @@index([createdAt])
}

// ─── YORUM ───────────────────────────────────────────────────
model Comment {
  id          String   @id @default(cuid())
  postId      String
  authorId    String
  content     String
  isAnonymous Boolean  @default(false)
  parentId    String?
  createdAt   DateTime @default(now())

  post    Post      @relation(fields: [postId],   references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies Comment[] @relation("Replies")
  likes   Like[]

  @@index([postId])
}

// ─── BEĞENİ ──────────────────────────────────────────────────
model Like {
  id           String   @id @default(cuid())
  userId       String
  postId       String?
  commentId    String?
  forumReplyId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId],       references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId],       references: [id], onDelete: Cascade)
  comment    Comment?    @relation(fields: [commentId],    references: [id], onDelete: Cascade)
  forumReply ForumReply? @relation(fields: [forumReplyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@unique([userId, forumReplyId])
}

// ─── KAYDEDİLENLER ───────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// ─── FORUM ───────────────────────────────────────────────────
model ForumTopic {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  content     String
  category    String   @default("Genel")
  isAnonymous Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isSolved    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([category])
  @@index([createdAt])
}

model ForumReply {
  id          String   @id @default(cuid())
  topicId     String
  authorId    String
  content     String
  isAnonymous Boolean  @default(false)
  isSolution  Boolean  @default(false)
  createdAt   DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId],  references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  Like[]

  @@index([topicId])
}

// ─── HUKUKİ YARDIM ───────────────────────────────────────────
model LegalQuestion {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  content     String
  category    String   @default("Diğer")
  isAnonymous Boolean  @default(false)
  isAnswered  Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers  LegalAnswer[]
  comments LegalComment[]

  @@index([category])
  @@index([isAnswered])
}

model LegalAnswer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  isOfficial Boolean  @default(false)
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())

  question LegalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId],   references: [id], onDelete: Cascade)

  @@index([questionId])
}

model LegalComment {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  question LegalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId],   references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ─── MESAJLAŞMA ──────────────────────────────────────────────
model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([createdAt])
}

// ─── ŞİKAYET ─────────────────────────────────────────────────
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter     User  @relation("Reporter",     fields: [reporterId],     references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])
  post         Post? @relation(fields: [postId], references: [id])

  @@index([status])
}

// ─── BİLDİRİM ────────────────────────────────────────────────
enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  LEGAL_ANSWER
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── DS HATIRLATMA ───────────────────────────────────────────
model DsSchedule {
  id            String   @id @default(cuid())
  userId        String   @unique
  imzaGunleri   String?  // JSON: ["Salı","Cuma"] — imza atılacak günler
  imzaSaati     String?  // "09:30"
  seminerler    String?  // JSON: ["2026-04-15","2026-05-20"] — seminer tarihleri
  hatirlatmaGun Int      @default(1) // kaç gün önce hatırlat
  telefon       String?
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── HABER ───────────────────────────────────────────────────
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  imageUrl  String?
  category  String   @default("Haber")
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([published])
  @@index([createdAt])
}

// ─── ŞİFRE SIFIRLAMA ─────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

// ─── ROZET ───────────────────────────────────────────────────
enum BadgeType {
  ILK_GONDERI        // İlk gönderiyi yaptı
  ILK_YORUM          // İlk yorumu yaptı
  AKTIF_UYE          // 30+ gün üye
  FORUMC             // 5+ forum konusu açtı
  HUKUK_DESTEKCI     // Hukuki soruya yanıt verdi (avukat)
  TOPLULUK_KAHRAMANI // 50+ beğeni aldı
  DAYANISMA          // 20+ yorum yaptı
  DS_KULLANICI       // DS hatırlatma kurdu
  SORUCU             // Hukuki soru sordu
  KAHRAMAN_100       // 100+ gönderi/yorum
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  type      BadgeType
  awardedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ─── DUYURU ──────────────────────────────────────────────────
model Announcement {
  id        String    @id @default(cuid())
  text      String
  link      String?
  linkText  String?
  color     String    @default("bg-gold-500 text-navy-800")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([active])
}

// ─── DESTEK AĞI ──────────────────────────────────────────────
model SupportResource {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  city        String?
  phone       String?
  email       String?
  website     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([city])
  @@index([category])
}

// ─── E-TİCARET: MAĞAZA MÜŞTERİSİ ──────────────────────────────
//
// Magaza musterisi, sosyal platformun (cezaevinden.com) User tablosundan
// AYRI tutuluyor. Sebep: User modeli o platformun dunyasi - roller
// MAHKUM/AILE/AVUKAT, iliskileri arasinda forum konulari, hukuki sorular,
// mesajlar ve rozetler var. Magazadan alisveris yapan biri o dunyaya ait
// olmak zorunda degil, ve iki urunu ayni tabloya baglamak birinde yapilan
// her degisikligi digerinin sorunu haline getirir.
//
// Ileride tek girise gecilmek istenirse yol acik: Customer.userId alani
// istege bagli olarak duruyor, doldurmak yeterli.

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String
  phone         String?
  /// scrypt ozeti. Bicim: scrypt$<N>$<r>$<p>$<tuz-b64>$<ozet-b64> (lib/musteri-auth.ts)
  passwordHash  String
  status        CustomerStatus @default(ACTIVE)

  /// KVKK aydinlatma metnine onay verildigi an. Onaysiz kayit olusturulmuyor.
  kvkkOnayAt    DateTime
  /// Ticari elektronik ileti (pazarlama e-postasi) izni. Ayri ve istege bagli.
  iletiIzniAt   DateTime?

  /// Sosyal platform hesabiyla eslesme. Simdilik kullanilmiyor; tek girise
  /// gecilirse doldurulacak.
  userId        String?        @unique

  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions  CustomerSession[]
  tokens    CustomerToken[]
  addresses Address[]
  orders    Order[]
  cart      Cart?
  favorites Favorite[]
  reviews   Review[]
  returns   Return[]

  @@index([email])
  @@index([createdAt])
}

/// Musteri oturumu.
///
/// JWT yerine veritabaninda tutulan opak jeton kullaniliyor: jeton iptal
/// edilebiliyor (sifre degisince tum oturumlar kapatilabilir, musteri
/// "diger cihazlardan cik" diyebilir) ve yeni bir bagimlilik gerektirmiyor.
///
/// Jetonun kendisi degil SHA-256 ozeti saklaniyor - OtpKodu ile ayni mantik:
/// veritabani okunsa bile yururlukteki oturumlar ele gecmesin.
model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

enum CustomerTokenType {
  EMAIL_DOGRULAMA
  SIFRE_SIFIRLAMA
}

/// E-posta dogrulama ve sifre sifirlama baglantilarindaki tek kullanimlik
/// jetonlar. Oturum jetonuyla ayni kuralla saklaniyor: yalnizca ozeti.
model CustomerToken {
  id         String            @id @default(cuid())
  customerId String
  type       CustomerTokenType
  tokenHash  String            @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@index([expiresAt])
}

/// Adres defteri.
///
/// Onceden siparis adresi Order.shippingAddress alaninda tek parca duz metin
/// olarak duruyordu: ikinci kez alisveris yapan musteri adresini bastan
/// yaziyor, kargo etiketi il/ilce ayristirilamiyor, fatura adresi ayri
/// verilemiyordu.
model Address {
  id                String   @id @default(cuid())
  customerId        String
  /// Musterinin verdigi ad: "Ev", "İş" gibi.
  title             String
  fullName          String
  phone             String
  city              String
  district          String
  neighborhood      String?
  addressLine       String
  postalCode        String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── E-TİCARET: KATEGORİLER ───────────────────────────────────
model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  description String?
  imageUrl  String?
  /// Kategorinin KDV orani (yuzde).
  ///
  /// Urun fiyatlari KDV DAHILDIR; bu oran KDV'yi fiyatin icinden hesaplamak
  /// icin kullaniliyor, fiyatin ustune eklemek icin degil (bkz. lib/fiyat.ts).
  /// Baslangic degeri sitenin bugune kadar uyguladigi %10; urun grubuna gore
  /// dogru oranlarin girilmesi mali musavir teyidi ister ve admin panelinden
  /// kod degistirmeden guncellenebilir.
  kdvOrani  Float     @default(10)
  createdAt DateTime  @default(now())

  products Product[]

  @@index([slug])
}

// ─── E-TİCARET: ÜRÜNLER ───────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  categoryId  String
  price       Float
  quantity    Int      @default(0)    // Stok
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  cartItems   CartItem[]
  campaigns   CampaignProduct[]
  reviews     Review[]
  favorites   Favorite[]
  preOrders   PreOrder[]
  images      ProductImage[]
  attributes  ProductAttribute[]

  @@index([categoryId])
  @@index([slug])
}

/// Urun gorselleri.
///
/// Product.imageUrl tek bir gorsel tutuyor ve oyle kaliyor: kart listeleri,
/// arama onerileri, siparis e-postalari ve sitemap hep onu okuyor. Bu tablo
/// onun yerine gecmiyor, UZERINE ekliyor - urun sayfasindaki galeri buradan
/// besleniyor. Bir urunun galerisi bosken sayfa yine imageUrl'i gosteriyor.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  /// Ekran okuyucu ve gorsel yuklenemedigi durum icin. Bos ise urun adi
  /// kullaniliyor.
  alt       String?
  /// Galerideki sira. Kucuk olan once.
  sira      Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sira])
}

/// Urun ozellikleri: "Agirlik: 500 g", "Malzeme: Mese".
///
/// Serbest ad/deger cifti olarak tutuluyor. Sabit bir alan listesi
/// tanimlanmadi: katalog gida, tekstil, ahsap ve el sanatlarini birden
/// kapsiyor, hepsine uyan bir alan kumesi yok. Faset filtreleme ilerde
/// bu tablodan beslenecek, bu yuzden ad alani indeksli.
model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  ad        String
  deger     String
  sira      Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ad])
  @@index([productId, sira])
  @@index([ad])
}

// ─── E-TİCARET: SEPET ─────────────────────────────────────────
/// Sunucu sepeti.
///
/// Bu tablo vardi ama hic kullanilmiyordu: sepet tamamen tarayicinin
/// localStorage'inda duruyordu, yani musteri telefonda doldurdugu sepeti
/// bilgisayarinda bulamiyordu. Artik magaza musterisine bagli.
///
/// userId (sosyal platform kullanicisi) istege bagli hale getirildi: magaza
/// sepetinin o tabloyla iliskisi yok.
model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  customerId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId],    references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// ─── E-TİCARET: SİPARİŞLER ────────────────────────────────────
enum OrderStatus {
  PENDING     // Ödeme bekleniyor
  CONFIRMED   // Ödeme onaylandı
  SHIPPED     // Gönderildi
  DELIVERED   // Teslim edildi
  CANCELLED   // İptal edildi
}

enum PaymentMethod {
  CREDIT_CARD // Kredi kartı
  TRANSFER    // Banka transferi/Havale
}

enum PaymentStatus {
  PENDING     // Ödeme bekleniyor
  COMPLETED   // Ödeme tamamlandı
  FAILED      // Ödeme başarısız
  CANCELLED   // İptal edildi
}

model Order {
  id              String        @id @default(cuid())
  userId          String?       // Guest checkout için optional
  /// Magaza musterisi. Misafir siparislerinde bos.
  customerId      String?
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  /// Musteriden tahsil edilecek nihai tutar: itemsTotal + shippingCost.
  totalAmount     Float
  paymentMethod   PaymentMethod
  paymentId       String?
  shippingAddress String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ─── Tutar kirilimi ───────────────────────────────────────────────
  //
  // Onceden sipariste yalnizca tek bir totalAmount duruyordu. Fatura
  // kesmek, iade tutari hesaplamak ve muhasebe mutabakati yapmak icin
  // kirilim sart; ustelik KDV orani kategoriye gore degisebildigi icin
  // sonradan geriye donuk hesaplanamiyor. Eski siparislerde bu alanlar
  // bos: o kayitlar icin kirilim hic uretilmedigi icin 0 yazmak yerine
  // "bilinmiyor" birakiliyor.

  /// KDV dahil urun toplami (kampanya indirimi uygulanmis hali).
  itemsTotal      Float?
  /// Kampanya indirimlerinin toplami. Bilgi amacli; totalAmount'a dahil degil.
  discountTotal   Float         @default(0)
  /// Siparise eklenen kargo bedeli. Kargo karsi odemeli oldugu surece 0.
  shippingCost    Float         @default(0)
  /// itemsTotal ICINDEKI KDV. Toplama ayrica eklenmez.
  taxTotal        Float?
  /// Fatura adresi. Bos ise teslimat adresi ile ayni kabul edilir.
  billingAddress  String?

  /// Siparisin teslim edildigi an.
  ///
  /// Cayma suresi SIPARIS tarihinden degil TESLIM tarihinden sayiliyor;
  /// bu alan olmadan 14 gunluk pencere dogru hesaplanamaz. Durum
  /// DELIVERED'a cekildiginde yaziliyor.
  deliveredAt     DateTime?

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  returns     Return[]
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float    // Ürünün satın alındığı fiyat
  createdAt DateTime @default(now())

  order       Order        @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
}

// ─── E-TİCARET: ÖDEMELER ──────────────────────────────────────
model Payment {
  id              String         @id @default(cuid())
  orderId         String?
  amount          Float
  currency        String         @default("TRY")
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  transactionId   String?        // Iyzico veya banka transaction ID
  description     String?
  metadata        String?        // JSON: Iyzico yanıtı vb.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order   Order[]

  @@index([status])
  @@index([transactionId])
}

// ─── E-TİCARET: KAMPANYALAR ───────────────────────────────────
model Campaign {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CampaignProduct[]

  @@index([active])
  @@index([startDate])
}

model CampaignProduct {
  id         String  @id @default(cuid())
  campaignId String
  productId  String
  discount   Float   // Yüzde (ör: 20 için %20 indirim)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
}

// ─── E-TİCARET: ÜRÜN YORUMLARI ────────────────────────────────
/// Urun yorumlari.
///
/// Yorum yazan artik magaza musterisi. Onceden yorum ucu yazarin kimligini
/// ISTEK GOVDESINDEN aliyordu: "userId" alanina baska birinin kimligini
/// yazan herkes onun adina yorum birakabiliyordu. Satin alma kontrolu de
/// ayni sahte kimlikle yapildigi icin bir ise yaramiyordu. Kimlik artik
/// oturumdan geliyor.
model Review {
  id            String   @id @default(cuid())
  productId     String
  /// Sosyal platform kullanicisi. Magaza tarafinda kullanilmiyor.
  userId        String?
  customerId    String?
  /// Yorumun dayandigi siparis kalemi: "dogrulanmis alisveris" rozetinin
  /// kaynagi. Yorum birakilirken bulunan kalem buraya yaziliyor; kalem
  /// silinirse rozet duser ama yorum kalir.
  orderItemId   String?
  rating        Int      // 1-5
  title         String?  // Yorum başlığı
  text          String   // Yorum metni
  approved      Boolean  @default(false)  // Admin onayı
  helpfulCount  Int      @default(0)     // Kaç kişi faydalı buldu
  createdAt     DateTime @default(now())

  product  Product   @relation(fields: [productId],  references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId, approved])
  @@index([userId])
  @@index([customerId])
  @@index([approved])
}

// ─── E-TİCARET: FAVORİLER ─────────────────────────────────────
/// Favoriler.
///
/// Onceden bu tabloya istemcide uretilen sahte bir "guest-user-<zaman>"
/// kimligiyle yazilmaya calisiliyor ve her kalp tiklamasi 500 donuyordu
/// (bkz. lib/favoriler.ts). Sitede musteri hesabi olmadigi icin favoriler
/// tarayiciya alinmisti; artik gercek bir sahibi var.
model Favorite {
  id         String   @id @default(cuid())
  userId     String?
  customerId String?
  productId  String
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId],  references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([customerId, productId])
  @@index([userId])
  @@index([customerId])
}

// ─── E-TİCARET: ÖN TALEP ──────────────────────────────────────
enum PreOrderStatus {
  WAITING    // Stok bekleniyor
  NOTIFIED   // Stoğa girdi, müşteriye haber verildi
  CONVERTED  // Müşteri siparişe dönüştürdü
  CANCELLED  // İptal / vazgeçildi
}

model PreOrder {
  id         String         @id @default(cuid())
  productId  String
  userId     String?        // Üye değilse null (misafir ön talebi)
  quantity   Int            @default(1)
  name       String
  email      String
  phone      String?
  note       String?        // Müşterinin eklemek istediği not
  status     PreOrderStatus @default(WAITING)
  notifiedAt DateTime?      // Stok bildirimi gönderildiği an
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId],    references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([email])
  @@index([createdAt])
}

/// Herkese acik formlar icin istek sayaci (hiz siniri).
///
/// Uygulama sunucusuz calisiyor: her istek ayri bir ornekte islenebiliyor, bu
/// yuzden bellekte tutulan bir sayac guvenilir degil. Sayac paylasilan tek
/// yerde, veritabaninda tutuluyor.
model IstekSayaci {
  /// "<uc adi>:<ip>" bicimi. Ornek: "on-talep:203.0.113.9"
  anahtar          String   @id
  adet             Int      @default(0)
  pencereBaslangic DateTime @default(now())

  @@index([pencereBaslangic])
}

/// Yonetici girisi icin tek kullanimlik kod.
///
/// Onceden bu kod bellekte (ya da REDIS_URL tanimliysa Redis'te) tutuluyordu.
/// Uygulama sunucusuz calistigi ve REDIS_URL tanimli olmadigi icin kodu ureten
/// ornek ile dogrulayan ornek farkli olabiliyordu: giris bazen "hatali kod"
/// veriyor, deneme sayaci da her ornekte sifirdan basladigi icin 5 deneme
/// siniri gercekte islemiyordu.
///
/// Kodun kendisi degil SHA-256 ozeti saklaniyor: veritabani okunsa bile
/// yururlukteki kod ele gecmesin.
model OtpKodu {
  email        String   @id
  kodOzeti     String
  denemeSayisi Int      @default(0)
  sonKullanma  DateTime
  olusturma    DateTime @default(now())

  @@index([sonKullanma])
}


// ─── E-TİCARET: İADE ──────────────────────────────────────────
//
// Alt bilgide "14 gün içinde cayma hakkı" yazıyor ve mesafeli satış
// sözleşmesi bunu taahhüt ediyordu, ama arkasında hiçbir süreç yoktu:
// ne model, ne müşteri ekranı, ne yönetim kuyruğu. Müşteri iade için
// iletişim formundan yazmak zorundaydı ve talebin izi kalmıyordu.

enum ReturnStatus {
  TALEP        // Müşteri talep etti, inceleniyor
  ONAYLANDI    // Kabul edildi, ürün bekleniyor
  REDDEDILDI   // Talep reddedildi
  URUN_ULASTI  // İade edilen ürün elimize ulaştı
  TAMAMLANDI   // Para iadesi yapıldı
  IPTAL        // Müşteri vazgeçti
}

model Return {
  id           String       @id @default(cuid())
  /// "IA-2026-001" biçiminde, müşteriye verilen takip numarası.
  returnNumber String       @unique
  orderId      String
  customerId   String?
  status       ReturnStatus @default(TALEP)

  /// Müşterinin seçtiği sebep ve açıklaması.
  reason       String
  note         String?

  /// Yöneticinin müşteriye ilettiği karar gerekçesi.
  adminNote    String?

  /// İade edilen tutar. Karar verilene kadar boş.
  refundAmount Float?
  refundedAt   DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order    Order        @relation(fields: [orderId],    references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    ReturnItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
}

/// İade edilen kalemler.
///
/// Sipariş kalemi bazında: müşteri üç ürünlük siparişin yalnızca birini
/// iade edebilmeli.
model ReturnItem {
  id          String @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int

  return    Return    @relation(fields: [returnId],    references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@index([returnId])
}

/// Yönetim işlemlerinin izi.
///
/// Önceden lib/audit-log.ts kayıtları BELLEKTE tutuyordu (modül düzeyinde bir
/// dizi, son 1000 satır). Uygulama sunucusuz çalışıyor: her istek ayrı bir
/// örnekte işlenebiliyor ve örnek kapanınca kayıt kayboluyor. Yani hangi
/// yöneticinin ne zaman giriş yaptığı, hangi iadeyi onayladığı, hangi fiyatı
/// değiştirdiği hiçbir yerde durmuyordu - para iadesi kararları için kabul
/// edilemez. Aynı sorun hız sayacında yaşanmış ve sayaç veritabanına
/// taşınmıştı (bkz. IstekSayaci); bu tablo aynı düzeltmenin denetim
/// günlüğü karşılığı.
model DenetimKaydi {
  id      String @id @default(cuid())

  /// İşlem kodu. Örnek: "OTP_VERIFY", "IADE_DURUM", "PREORDER_NOTIFY".
  islem   String

  /// İşlemi yapan. Yönetici e-postası, bilinmiyorsa "admin".
  eposta  String

  /// "success" | "failed"
  durum   String

  /// Serbest açıklama: neyin değiştiği, hata sebebi vb.
  ayrinti String?

  /// İstemci adresi (x-forwarded-for ilk değeri).
  ip      String?

  olusturulma DateTime @default(now())

  @@index([olusturulma])
  @@index([eposta, olusturulma])
  @@index([islem, olusturulma])
}
