NODE_ENV=production

# ========================================
# VERCEL'DE AYARLANACAK ORTAM DEĞİŞKENLERİ
# ========================================

# Database - Neon.tech PostgreSQL
DATABASE_URL=<vercel-de-ayarlanacak>

# Authentication - NextAuth
NEXTAUTH_SECRET=<vercel-de-ayarlanacak-güvenli-anahtar>
NEXTAUTH_URL=https://isyurtlari.com.tr

# Admin Panel Authentication
ADMIN_PASSWORD=<vercel-de-ayarlanacak>
ADMIN_TOKEN=<vercel-de-ayarlanacak>

# Bank Transfer Details (for orders)
BANK_ACCOUNT_NAME=<vercel-de-ayarlanacak>
BANK_ACCOUNT_IBAN=<vercel-de-ayarlanacak>
BANK_ACCOUNT_BRANCH=<vercel-de-ayarlanacak>
BANK_ACCOUNT_NO=<vercel-de-ayarlanacak>

# ========================================
# PUBLIC DEĞIŞKENLER (Güvenli - açıkta olabilir)
# ========================================

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-TQBZ9JDV5T

# Site Domain
NEXT_PUBLIC_DOMAIN=isyurtlari.com.tr

# ========================================
# SONRAKI AŞAMALAR (Şu an devre dışı)
# ========================================
# IYZICO_API_KEY=<yakında>
# IYZICO_SECRET_KEY=<yakında>
